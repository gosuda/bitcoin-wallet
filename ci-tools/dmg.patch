+name: release
+
+# Tag a version to publish installers, or run it by hand to check that the
+# bundles still build. A manual run uploads artifacts and creates nothing.
+on:
+  push:
+    tags: ["v*"]
+  workflow_dispatch:
+
+permissions:
+  contents: write
+
+env:
+  CARGO_TERM_COLOR: always
+  RELEASE_TAG: ${{ startsWith(github.ref, 'refs/tags/v') && github.ref_name || '' }}
+
+jobs:
+  # A tag names the version it releases. One that disagrees with the workspace
+  # would publish installers numbered differently from their tag, so nothing
+  # is built until the two match. A manual run just checks the copies agree.
+  version:
+    name: version matches the tag
+    runs-on: depot-ubuntu-24.04
+    timeout-minutes: 5
+    steps:
+      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7
+      - name: Check the version, and the tag when there is one
+        run: scripts/check-version.sh ${RELEASE_TAG:+"$RELEASE_TAG"}
+
+  bundle:
+    name: ${{ matrix.name }}
+    needs: version
+    # Depot macOS removes the shared-pool queue; the 16-CPU Depot Windows
+    # runner feeds the parallel crate builds. Matrix values and job names
+    # stay unchanged, so the release verdicts report as before.
+    runs-on: ${{ (matrix.os == 'macos-latest' && 'depot-macos-latest') || (matrix.os == 'windows-latest' && 'depot-windows-2025-16') || 'depot-ubuntu-24.04' }}
+    # A release build, with thin LTO, one codegen unit and notarisation.
+    timeout-minutes: 60
+    strategy:
+      fail-fast: false
+      matrix:
+        include:
+          - os: macos-latest
+            name: macOS (apple silicon)
+            args: --target aarch64-apple-darwin
+            rust-target: aarch64-apple-darwin
+          - os: macos-latest
+            name: macOS (intel)
+            args: --target x86_64-apple-darwin
+            rust-target: x86_64-apple-darwin
+          - os: ubuntu-24.04
+            name: Linux
+            args: ""
+            rust-target: ""
+          - os: windows-latest
+            name: Windows
+            args: ""
+            rust-target: ""
+    steps:
+      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7
+
+      - uses: dtolnay/rust-toolchain@39008827e6b4319a349e9a42dfc90579dd25f1ca # stable
+        with:
+          targets: wasm32-unknown-unknown${{ matrix.rust-target && format(',{0}', matrix.rust-target) || '' }}
+      - uses: Swatinem/rust-cache@d1527c8f67ef9af357290475d4af4b0fab8f12e0 # v2
+
+      - name: Install Linux build dependencies
+        if: matrix.os == 'ubuntu-24.04'
+        run: |
+          sudo apt-get update
+          sudo apt-get install -y libwebkit2gtk-4.1-dev libappindicator3-dev librsvg2-dev patchelf
+
+      - uses: ./.github/actions/frontend
+
+      # Signing and notarisation happen only when these secrets exist (see
+      # docs/RELEASING.md). A missing secret arrives as an empty variable, and
+      # Tauri signs whenever APPLE_CERTIFICATE is set at all, so each is exported
+      # only when it has a value.
+      - name: Export the Apple signing secrets that exist
+        if: runner.os == 'macOS'
+        env:
+          APPLE_CERTIFICATE: ${{ secrets.APPLE_CERTIFICATE }}
+          APPLE_CERTIFICATE_PASSWORD: ${{ secrets.APPLE_CERTIFICATE_PASSWORD }}
+          APPLE_SIGNING_IDENTITY: ${{ secrets.APPLE_SIGNING_IDENTITY }}
+          APPLE_ID: ${{ secrets.APPLE_ID }}
+          APPLE_PASSWORD: ${{ secrets.APPLE_PASSWORD }}
+          APPLE_TEAM_ID: ${{ secrets.APPLE_TEAM_ID }}
+        run: |
+          for name in APPLE_CERTIFICATE APPLE_CERTIFICATE_PASSWORD APPLE_SIGNING_IDENTITY \
+            APPLE_ID APPLE_PASSWORD APPLE_TEAM_ID; do
+            value="${!name}"
+            [ -n "$value" ] || continue
+            delimiter="EOF_$(openssl rand -hex 8)"
+            printf '%s<<%s\n%s\n%s\n' "$name" "$delimiter" "$value" "$delimiter" >> "$GITHUB_ENV"
+          done
+
+      - uses: tauri-apps/tauri-action@1deb371b0cd8bd54025b384f1cd735e725c4060f # v1
+        env:
+          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
+          CI: "true"
+          TAURI_BUNDLER_DMG_IGNORE_CI: "false"
+        with:
+          projectPath: apps/native
+          tagName: ${{ env.RELEASE_TAG }}
+          releaseName: ${{ env.RELEASE_TAG }}
+          releaseDraft: true
+          prerelease: false
+          # No updater, and tauri-action defaults this to true.
+          uploadUpdaterJson: false
+          args: ${{ matrix.args }}
+
+      - name: Keep the bundles for a manual run
+        if: ${{ !env.RELEASE_TAG }}
+        uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9 # v7
+        with:
+          name: bundle-${{ matrix.os }}-${{ matrix.rust-target || 'native' }}
+          path: |
+            target/release/bundle/**
+            target/*/release/bundle/**
+          if-no-files-found: error
+          retention-days: 7
+
+  # Which store signing keys the repository holds. A phone leg below runs only
+  # when its key exists — without one there is nothing it could publish — and a
+  # job's `if` cannot read secrets directly, hence this job.
+  keys:
+    name: which signing keys exist
+    runs-on: depot-ubuntu-24.04
+    timeout-minutes: 5
+    outputs:
+      android: ${{ steps.check.outputs.android }}
+      ios: ${{ steps.check.outputs.ios }}
+    steps:
+      - id: check
+        env:
+          ANDROID_KEYSTORE_BASE64: ${{ secrets.ANDROID_KEYSTORE_BASE64 }}
+          APPLE_API_KEY_P8: ${{ secrets.APPLE_API_KEY_P8 }}
+        run: |
+          echo "android=${ANDROID_KEYSTORE_BASE64:+true}" >> "$GITHUB_OUTPUT"
+          echo "ios=${APPLE_API_KEY_P8:+true}" >> "$GITHUB_OUTPUT"
+
+  android:
+    name: Android (signed)
+    needs: [version, keys, bundle]
+    if: needs.keys.outputs.android == 'true'
+    runs-on: depot-ubuntu-24.04
+    # All four ABIs, each a full release build of the Rust library.
+    timeout-minutes: 120
+    steps:
+      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7
+      - uses: dtolnay/rust-toolchain@39008827e6b4319a349e9a42dfc90579dd25f1ca # stable
+        with:
+          targets: aarch64-linux-android,armv7-linux-androideabi,i686-linux-android,x86_64-linux-android,wasm32-unknown-unknown
+      - uses: Swatinem/rust-cache@d1527c8f67ef9af357290475d4af4b0fab8f12e0 # v2
+      - uses: actions/setup-java@d1374f8ac74474200d16ef8ecee22c7ae7a51880 # v6
+        with:
+          distribution: temurin
+          java-version: 17
+      - uses: ./.github/actions/frontend
+
+      # The keystore exists only in this job's temporary directory; the Gradle
+      # build reads it through ANDROID_KEYSTORE_* (app/build.gradle.kts).
+      - name: Build the signed APK and app bundle
+        working-directory: apps/native
+        env:
+          ANDROID_KEYSTORE_BASE64: ${{ secrets.ANDROID_KEYSTORE_BASE64 }}
+          ANDROID_KEYSTORE_PASSWORD: ${{ secrets.ANDROID_KEYSTORE_PASSWORD }}
+          ANDROID_KEY_ALIAS: ${{ secrets.ANDROID_KEY_ALIAS }}
+          ANDROID_KEY_PASSWORD: ${{ secrets.ANDROID_KEY_PASSWORD }}
+        run: |
+          export NDK_HOME="$ANDROID_NDK_LATEST_HOME"
+          export ANDROID_KEYSTORE_PATH="$RUNNER_TEMP/upload.keystore"
+          printf '%s' "$ANDROID_KEYSTORE_BASE64" | base64 -d > "$ANDROID_KEYSTORE_PATH"
+          pnpm tauri android build --apk --aab --ci
+
+      - name: Check the APK carries the upload key's signature
+        run: |
+          apksigner=""
+          for tools in "$ANDROID_HOME"/build-tools/*/; do apksigner="${tools}apksigner"; done
+          for apk in apps/native/src-tauri/gen/android/app/build/outputs/apk/*/release/*.apk; do
+            "$apksigner" verify --print-certs "$apk"
+          done
+
+      - name: Attach to the draft release
+        if: env.RELEASE_TAG
+        env:
+          GH_TOKEN: ${{ github.token }}
+        run: |
+          gh release upload "$RELEASE_TAG" --clobber \
+            apps/native/src-tauri/gen/android/app/build/outputs/apk/*/release/*.apk \
+            apps/native/src-tauri/gen/android/app/build/outputs/bundle/*/*.aab
+
+      - name: Keep them for a manual run
+        if: ${{ !env.RELEASE_TAG }}
+        uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9 # v7
+        with:
+          name: android-release
+          path: |
+            apps/native/src-tauri/gen/android/app/build/outputs/apk/*/release/*.apk
+            apps/native/src-tauri/gen/android/app/build/outputs/bundle/*/*.aab
+          if-no-files-found: error
+          retention-days: 7
+
+  # An .ipa for the devices registered to the team (ad hoc), signed through an
+  # App Store Connect API key: Xcode fetches or creates the distribution
+  # certificate and the profile itself, so nothing is imported into a keychain.
+  ios:
+    name: iOS (signed, registered devices)
+    needs: [version, keys, bundle]
+    if: needs.keys.outputs.ios == 'true'
+    runs-on: depot-macos-latest
+    timeout-minutes: 90
+    steps:
+      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7
+      - uses: dtolnay/rust-toolchain@39008827e6b4319a349e9a42dfc90579dd25f1ca # stable
+        with:
+          targets: aarch64-apple-ios,wasm32-unknown-unknown
+      - uses: Swatinem/rust-cache@d1527c8f67ef9af357290475d4af4b0fab8f12e0 # v2
+      - uses: ./.github/actions/frontend
+
+      # The CLI reads the team from APPLE_DEVELOPMENT_TEAM and the key from a
+      # file, so the key exists only in this job's temporary directory.
+      - name: Build and sign the app
+        working-directory: apps/native
+        env:
+          APPLE_DEVELOPMENT_TEAM: ${{ secrets.APPLE_TEAM_ID }}
+          APPLE_API_ISSUER: ${{ secrets.APPLE_API_ISSUER }}
+          APPLE_API_KEY: ${{ secrets.APPLE_API_KEY }}
+          APPLE_API_KEY_P8: ${{ secrets.APPLE_API_KEY_P8 }}
+        run: |
+          export APPLE_API_KEY_PATH="$RUNNER_TEMP/AuthKey_$APPLE_API_KEY.p8"
+          printf '%s\n' "$APPLE_API_KEY_P8" > "$APPLE_API_KEY_PATH"
+          pnpm tauri ios build --export-method release-testing --ci
+
+      - name: Check the app's signature
+        run: |
+          for ipa in apps/native/src-tauri/gen/apple/build/*/*.ipa; do
+            unpacked=$(mktemp -d)
+            ditto -x -k "$ipa" "$unpacked"
+            codesign --verify --deep --strict --verbose=2 "$unpacked"/Payload/*.app
+            codesign --display --verbose=2 "$unpacked"/Payload/*.app
+          done
+
+      - name: Attach to the draft release
+        if: env.RELEASE_TAG
+        env:
+          GH_TOKEN: ${{ github.token }}
+        run: gh release upload "$RELEASE_TAG" --clobber apps/native/src-tauri/gen/apple/build/*/*.ipa
+
+      - name: Keep it for a manual run
+        if: ${{ !env.RELEASE_TAG }}
+        uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9 # v7
+        with:
