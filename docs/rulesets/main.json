{
  "name": "main",
  "target": "branch",
  "enforcement": "active",
  "conditions": {
    "ref_name": { "include": ["~DEFAULT_BRANCH"], "exclude": [] }
  },
  "bypass_actors": [],
  "rules": [
    { "type": "deletion" },
    { "type": "non_fast_forward" },
    {
      "type": "pull_request",
      "parameters": {
        "required_approving_review_count": 0,
        "dismiss_stale_reviews_on_push": false,
        "require_code_owner_review": false,
        "require_last_push_approval": false,
        "required_review_thread_resolution": false,
        "allowed_merge_methods": ["merge", "squash", "rebase"]
      }
    },
    {
      "type": "required_status_checks",
      "parameters": {
        "strict_required_status_checks_policy": false,
        "do_not_enforce_on_create": false,
        "required_status_checks": [
          { "context": "wallet-core (ubuntu-24.04)", "integration_id": 15368 },
          { "context": "wallet-core (macos-latest)", "integration_id": 15368 },
          { "context": "wallet-core (windows-latest)", "integration_id": 15368 },
          { "context": "end-to-end on regtest", "integration_id": 15368 },
          { "context": "cargo deny", "integration_id": 15368 },
          { "context": "wallet-core + wallet-wasm (wasm32)", "integration_id": 15368 },
          { "context": "app shell (iOS)", "integration_id": 15368 },
          { "context": "app shell (iOS Simulator)", "integration_id": 15368 },
          { "context": "app shell (Android)", "integration_id": 15368 },
          { "context": "desktop + web apps", "integration_id": 15368 }
        ]
      }
    }
  ]
}
