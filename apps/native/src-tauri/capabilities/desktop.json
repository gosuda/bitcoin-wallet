{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "desktop",
  "description": "Desktop window: IPC, config store, clipboard write, explorer links, chain requests.",
  "windows": [
    "main"
  ],
  "platforms": [
    "linux",
    "macOS",
    "windows"
  ],
  "permissions": [
    "core:default",
    "store:default",
    "clipboard-manager:allow-write-text",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://mempool.space/*"
        },
        {
          "url": "https://blockstream.info/*"
        }
      ]
    },
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "https://*"
        },
        {
          "url": "https://*/*"
        },
        {
          "url": "http://localhost:*/*"
        },
        {
          "url": "http://127.0.0.1:*/*"
        }
      ]
    }
  ]
}
