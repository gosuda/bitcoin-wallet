<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Shown verbatim in the iOS permission prompt, so it says what the camera
	     is for rather than that the app would like access to it. -->
	<key>NSCameraUsageDescription</key>
	<string>Scanning a QR code fills in a Bitcoin address so you do not have to type it.</string>
	<key>NSFaceIDUsageDescription</key>
	<string>Face ID unlocks the wallet key saved on this device.</string>
</dict>
</plist>
