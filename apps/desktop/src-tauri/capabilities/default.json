{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window: IPC, config store, clipboard write, explorer links.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "store:default",
    "clipboard-manager:allow-write-text",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "https://mempool.space/*" }, { "url": "https://blockstream.info/*" }]
    }
  ]
}
